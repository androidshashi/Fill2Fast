{
  "name": "fill2fast",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first job application autofill Chrome extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/androidshashi/Fill2Fast.git"
  },
  "homepage": "https://github.com/androidshashi/Fill2Fast#readme",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build && vite build -c vite.content.config.ts",
    "build:fast": "vite build && vite build -c vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
